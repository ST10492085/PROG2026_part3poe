@model CategoryFormViewModel
<div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
<input type="hidden" asp-for="Id" />
<input type="hidden" asp-for="EventId" />
<input type="hidden" asp-for="EventName" />

<div class="mb-3">
    <label asp-for="Name" class="form-label"></label>
    <input asp-for="Name" class="form-control" placeholder="e.g. Under 20, Senior, 10km" />
    <span asp-validation-for="Name" class="text-danger small"></span>
</div>
<div class="mb-3">
    <label asp-for="Description" class="form-label"></label>
    <input asp-for="Description" class="form-control" />
</div>
<div class="row">
    <div class="col-md-4 mb-3">
        <label asp-for="MinAge" class="form-label"></label>
        <input asp-for="MinAge" type="number" class="form-control" />
        <span asp-validation-for="MinAge" class="text-danger small"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="MaxAge" class="form-label"></label>
        <input asp-for="MaxAge" type="number" class="form-control" />
        <span asp-validation-for="MaxAge" class="text-danger small"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="DistanceKm" class="form-label"></label>
        <input asp-for="DistanceKm" type="number" step="0.1" class="form-control" />
        <span asp-validation-for="DistanceKm" class="text-danger small"></span>
    </div>
</div>
