@model CategoryFormViewModel
@{
    ViewData["Title"] = "Add category";
}
<h1 class="page-title">Add category</h1>
<p class="text-muted">Event: @Model.EventName</p>
<div class="card"><div class="card-body">
    <form asp-action="Create" method="post">
        <partial name="_CategoryForm" model="Model" />
        <button type="submit" class="btn btn-accent">Add category</button>
        <a class="btn btn-outline-secondary" asp-action="Index" asp-route-eventId="@Model.EventId">Cancel</a>
    </form>
</div></div>
