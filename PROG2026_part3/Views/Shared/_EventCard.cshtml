@model EventModel
@{
    string status = DisplayHelper.EventStatus(Model.EventDate, DateTime.Now);
    string banner = string.IsNullOrEmpty(Model.BannerImageUrl)
        ? Url.Content("~/images/default-banner.svg")
        : Model.BannerImageUrl;
}
<div class="card event-card h-100">
    <div class="event-card-image">
        <img src="@banner" alt="Banner for @Model.Name" />
        <span class="badge event-type @DisplayHelper.EventTypeBadgeClass(Model.EventType)">@Model.EventType</span>
        <span class="badge event-status @DisplayHelper.StatusBadgeClass(status)">@status</span>
    </div>
    <div class="card-body d-flex flex-column">
        <h5 class="card-title">@Model.Name</h5>
        <p class="card-text text-muted small mb-1"><i class="bi bi-calendar3"></i> @Model.EventDate.ToString("ddd, dd MMM yyyy HH:mm")</p>
        <p class="card-text text-muted small mb-1"><i class="bi bi-geo-alt"></i> @Model.Location</p>
        <p class="card-text text-muted small"><i class="bi bi-signpost-split"></i> @Model.DistanceKm.ToString("0.##") km &middot; @Model.Categories.Count @(Model.Categories.Count == 1 ? "category" : "categories")</p>
        <a class="btn btn-accent mt-auto" asp-controller="Events" asp-action="Details" asp-route-id="@Model.Id">View details</a>
    </div>
</div>
