@model List<MyEventItem>
@{
    ViewData["Title"] = "My Events";
}
<h1 class="page-title">My Events</h1>
<p class="text-muted">Every event you have enrolled for, with the category you chose and your enrolment status.</p>

@if (Model.Count == 0)
{
    <div class="empty-state text-center">
        <i class="bi bi-ticket-perforated"></i>
        <h4>You have not enrolled for any events yet</h4>
        <a class="btn btn-accent" asp-controller="Home" asp-action="Index">Browse events</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle bg-white rounded">
            <thead>
                <tr><th>Event</th><th>Date</th><th>Location</th><th>Category</th><th>Enrolled on</th><th>Status</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (MyEventItem item in Model)
                {
                    <tr>
                        <td><a asp-controller="Events" asp-action="Details" asp-route-id="@item.Enrollment.EventId"><strong>@item.Enrollment.EventName</strong></a></td>
                        <td>@item.EventDate.ToString("dd MMM yyyy HH:mm")</td>
                        <td>@item.Location</td>
                        <td>@item.Enrollment.CategoryName</td>
                        <td>@item.Enrollment.EnrolledAt.ToString("dd MMM yyyy")</td>
                        <td><span class="badge @DisplayHelper.StatusBadgeClass(item.Status)">@item.Status</span></td>
                        <td class="text-end">
                            @if (item.CanCancel)
                            {
                                <form asp-action="Cancel" method="post" onsubmit="return confirm('Cancel your enrolment?');">
                                    <input type="hidden" name="eventId" value="@item.Enrollment.EventId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
