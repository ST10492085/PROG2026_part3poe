@model List<MyResultItem>
@{
    ViewData["Title"] = "My Results";
}
<h1 class="page-title">My Results</h1>
<p class="text-muted">Your personal race history. Results are captured by the organiser after each event.</p>

@if (Model.Count == 0)
{
    <div class="empty-state text-center">
        <i class="bi bi-trophy"></i>
        <h4>No results yet</h4>
        <p class="text-muted">Once an organiser captures your result for an event you entered, it will appear here.</p>
        <a class="btn btn-accent" asp-controller="Participant" asp-action="MyEvents">View my events</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle bg-white rounded">
            <thead>
                <tr><th>Event</th><th>Date</th><th>Category</th><th>Finish time</th><th>Position</th></tr>
            </thead>
            <tbody>
                @foreach (MyResultItem item in Model)
                {
                    <tr>
                        <td><a asp-controller="Events" asp-action="Details" asp-route-id="@item.Result.EventId"><strong>@item.Result.EventName</strong></a></td>
                        <td>@item.EventDate.ToString("dd MMM yyyy")</td>
                        <td>@item.Result.CategoryName</td>
                        <td class="finish-time">@DisplayHelper.FormatFinishTime(item.Result.FinishTime)</td>
                        <td>
                            @* e.g. "47th out of 312 finishers" *@
                            <span class="position-badge @(item.Result.Position <= 3 ? "podium" : "")">@DisplayHelper.Ordinal(item.Result.Position)</span>
                            out of @item.TotalFinishers @(item.TotalFinishers == 1 ? "finisher" : "finishers")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
