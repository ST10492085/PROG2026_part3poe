@model List<EventModel>
@{
    ViewData["Title"] = "My Events";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="page-title mb-0">My Events</h1>
        <p class="text-muted mb-0">Create and manage the events you organise.</p>
    </div>
    <a class="btn btn-accent" asp-action="Create"><i class="bi bi-plus-lg"></i> New event</a>
</div>

@if (Model.Count == 0)
{
    <div class="empty-state text-center">
        <i class="bi bi-calendar-plus"></i>
        <h4>You have not created any events yet</h4>
        <a class="btn btn-accent" asp-action="Create">Create your first event</a>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (EventModel ev in Model)
        {
            string status = DisplayHelper.EventStatus(ev.EventDate, DateTime.Now);
            string banner = string.IsNullOrEmpty(ev.BannerImageUrl) ? Url.Content("~/images/default-banner.svg") : ev.BannerImageUrl;
            <div class="col-md-6 col-lg-4">
                <div class="card event-card h-100">
                    <div class="event-card-image">
                        <img src="@banner" alt="Banner for @ev.Name" />
                        <span class="badge event-type @DisplayHelper.EventTypeBadgeClass(ev.EventType)">@ev.EventType</span>
                        <span class="badge event-status @DisplayHelper.StatusBadgeClass(status)">@status</span>
                    </div>
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@ev.Name</h5>
                        <p class="text-muted small mb-1"><i class="bi bi-calendar3"></i> @ev.EventDate.ToString("ddd, dd MMM yyyy HH:mm")</p>
                        <p class="text-muted small mb-3"><i class="bi bi-geo-alt"></i> @ev.Location &middot; @ev.DistanceKm.ToString("0.##") km</p>

                        <div class="d-flex flex-wrap gap-1 mt-auto">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@ev.Id"><i class="bi bi-pencil"></i> Edit</a>
                            <a class="btn btn-sm btn-outline-secondary" asp-controller="OrganizerCategories" asp-action="Index" asp-route-eventId="@ev.Id"><i class="bi bi-tags"></i> Categories</a>
                            <a class="btn btn-sm btn-outline-secondary" asp-controller="OrganizerEnrolments" asp-action="Index" asp-route-eventId="@ev.Id"><i class="bi bi-people"></i> Enrolments</a>
                            <a class="btn btn-sm btn-outline-secondary" asp-controller="OrganizerResults" asp-action="Index" asp-route-eventId="@ev.Id"><i class="bi bi-trophy"></i> Results</a>
                            <form asp-action="Delete" asp-route-id="@ev.Id" method="post" onsubmit="return confirm('Delete this event? This cannot be undone.');">
                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Delete</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
