@model EventFormViewModel
@{
    ViewData["Title"] = "Edit event";
}
<h1 class="page-title">Edit event</h1>
<div class="card"><div class="card-body">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
        <partial name="_EventForm" model="Model" />
        <button type="submit" class="btn btn-accent">Save changes</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
    </form>
</div></div>
