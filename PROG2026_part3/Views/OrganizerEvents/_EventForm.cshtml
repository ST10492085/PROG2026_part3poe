@model EventFormViewModel
@* The form shared by the Create and Edit pages. enctype="multipart/form-data" is REQUIRED for file uploads. *@
<div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
<input type="hidden" asp-for="Id" />

<div class="mb-3">
    <label asp-for="Name" class="form-label"></label>
    <input asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger small"></span>
</div>
<div class="mb-3">
    <label asp-for="Description" class="form-label"></label>
    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
    <span asp-validation-for="Description" class="text-danger small"></span>
</div>
<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="EventDate" class="form-label"></label>
        <input asp-for="EventDate" type="datetime-local" class="form-control" />
        <span asp-validation-for="EventDate" class="text-danger small"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="Location" class="form-label"></label>
        <input asp-for="Location" class="form-control" />
        <span asp-validation-for="Location" class="text-danger small"></span>
    </div>
</div>
<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="DistanceKm" class="form-label"></label>
        <input asp-for="DistanceKm" type="number" step="0.1" class="form-control" />
        <span asp-validation-for="DistanceKm" class="text-danger small"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="EventType" class="form-label"></label>
        <select asp-for="EventType" class="form-select">
            <option value="Run">Run</option>
            <option value="Walk">Walk</option>
            <option value="Cycle">Cycle</option>
        </select>
        <span asp-validation-for="EventType" class="text-danger small"></span>
    </div>
</div>
<div class="mb-3">
    <label asp-for="BannerFile" class="form-label"></label>
    @if (!string.IsNullOrEmpty(Model.ExistingBannerUrl))
    {
        <div class="mb-2">
            <img src="@Model.ExistingBannerUrl" alt="Current banner" class="banner-preview" />
            <div class="form-text">Current banner. Choose a new file below to replace it.</div>
        </div>
    }
    <input asp-for="BannerFile" type="file" accept="image/png,image/jpeg,image/gif,image/webp" class="form-control" />
    <div class="form-text">Optional. JPG, PNG, GIF or WEBP, up to 5 MB. Stored in Azure Blob Storage.</div>
    <span asp-validation-for="BannerFile" class="text-danger small"></span>
</div>
