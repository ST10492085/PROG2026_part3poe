@model LoginViewModel
@{
    ViewData["Title"] = "Log in";
}
<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card auth-card">
            <div class="card-body p-4">
                <h2 class="mb-1">Welcome back</h2>
                <p class="text-muted">Log in to enter events or manage your races.</p>

                @if (ViewBag.Info != null)
                {
                    <div class="alert alert-info">@ViewBag.Info</div>
                }

                <form asp-action="Login" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" autocomplete="email" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-accent w-100">Log in</button>
                </form>

                <p class="text-center mt-3 mb-0">New to RaceDay? <a asp-action="Register">Create an account</a></p>
            </div>
        </div>
    </div>
</div>
